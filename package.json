{
  "name": "write-once-markdown",
  "description": "Official Markdown integration for write-once.",
  "keywords": [
    "integration",
    "markdown",
    "opinionated-ts",
    "plugin",
    "write-once"
  ],
  "homepage": "https://github.com/opinionated-ts/write-once-markdown#readme",
  "bugs": {
    "url": "https://github.com/opinionated-ts/write-once-markdown/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Opinionated TS",
    "url": "https://github.com/opinionated-ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opinionated-ts/write-once-markdown.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "cspell": "cspell lint .",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "bun fmt && bun lint && bun cspell",
    "fix": "bun fmt:fix && bun lint:fix",
    "hooks:install": "lefthook install",
    "skills:install": "bun skills experimental_install",
    "test": "bun run build && vitest run",
    "test:unit": "vitest run tests/markdown-plugin.test.ts",
    "test:integration": "bun run build && vitest run tests/integration",
    "pack:check": "bun run build && bun scripts/check-package.ts",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "audit": "bun audit fix --ignore GHSA-vfj7-8cjw-p6xm",
    "build": "tsdown",
    "build:watch": "tsdown --watch"
  },
  "dependencies": {
    "write-once": "^2.0.0"
  },
  "devDependencies": {
    "@opinionated-ts/config": "^1.9.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "@vitest/coverage-istanbul": "5.0.3",
    "skills": "^1.7.1",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "bun": "^1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
